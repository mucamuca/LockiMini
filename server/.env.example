NODE_ENV=development
PORT=4000
# connection_limit=1: o SQLite so aceita um escritor por vez; serializar no
# pool evita erro de lock em vez de deixar as requisicoes brigarem pelo arquivo.
DATABASE_URL="file:./dev.db?connection_limit=1&pool_timeout=20"

# OBRIGATORIO: gere o seu antes de subir para qualquer lugar publico.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="cole-aqui-um-segredo-aleatorio-de-32-ou-mais-caracteres"
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30

WEB_ORIGIN=http://localhost:5173

# "mock" roda sem credencial nenhuma. Use "stripe" + as chaves para o gateway real.
PAYMENT_PROVIDER=mock
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

RESERVATION_TTL_MINUTES=20
FREE_SHIPPING_THRESHOLD_CENTS=29900
FLAT_SHIPPING_CENTS=2490
